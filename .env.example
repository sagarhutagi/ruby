# Ruby Application Configuration

# Server
RUBY_HOST=127.0.0.1
RUBY_PORT=8000
RUBY_FRONTEND_URL=http://127.0.0.1:5173
RUBY_ENV=development
LOG_LEVEL=INFO

# Storage & Data Paths
RUBY_DATA_DIR=./data
RUBY_DB_FILE=./data/ruby.db
RUBY_CHROMA_DIR=./data/chroma
RUBY_DOCUMENTS_DIR=./data/documents
RUBY_CACHE_DIR=./data/cache

# Security & Encryption (used when system keyring is unavailable)
RUBY_ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-base64-key

# AI Providers (Default endpoints and optional env-based keys)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Default Models
DEFAULT_CHAT_PROVIDER=ollama
DEFAULT_CHAT_MODEL=llama3.2:latest
DEFAULT_EMBEDDING_PROVIDER=sentence-transformers
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
